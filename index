<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hide and Seek: English Word Hunter 2.5D</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts & FontAwesome -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    body {
      font-family: 'Quicksand', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      overflow-x: hidden;
    }
    .font-fredoka {
      font-family: 'Fredoka', cursive;
    }
    .game-viewport {
      cursor: crosshair;
    }

    /* Pop-out & Soaked Crying Animation for Captured Yellow Figure */
    @keyframes yellowDummySurrender {
      0% {
        transform: scale(0.2) translateY(30px);
        opacity: 0;
      }
      50% {
        transform: scale(1.15) translateY(-10px);
        opacity: 1;
      }
      75% {
        transform: scale(0.95) translateY(2px);
      }
      100% {
        transform: scale(1) translateY(0);
        opacity: 1;
      }
    }
    .animate-dummy-surrender {
      animation: yellowDummySurrender 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    /* Gentle shivering for captured figures standing in room */
    @keyframes dummyShiver {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      25% { transform: translateY(-1.5px) rotate(-1deg); }
      75% { transform: translateY(1px) rotate(1deg); }
    }
    .animate-shivering {
      animation: dummyShiver 1.8s infinite ease-in-out;
    }

    /* Prop wiggle when shot */
    @keyframes propShake {
      0%, 100% { transform: rotate(0deg) scale(1); }
      20% { transform: rotate(-5deg) scale(1.05); }
      40% { transform: rotate(5deg) scale(1.05); }
      60% { transform: rotate(-3deg) scale(1.02); }
      80% { transform: rotate(3deg) scale(1.02); }
    }
    .shake-prop {
      animation: propShake 0.45s ease-in-out;
    }

    /* OBJECT ELIMINATION ANIMATION: Object puffs away while Yellow Figure stays! */
    @keyframes eliminateObjectOnly {
      0% {
        transform: scale(1) rotate(0deg);
        opacity: 1;
        filter: brightness(1);
      }
      30% {
        transform: scale(1.1) rotate(-4deg);
        filter: brightness(1.7) drop-shadow(0 0 16px #38bdf8);
      }
      100% {
        transform: scale(0.02) translateY(-40px) rotate(20deg);
        opacity: 0;
        filter: blur(8px) brightness(2.2);
        visibility: hidden;
      }
    }
    .animate-eliminate-object {
      animation: eliminateObjectOnly 0.65s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      pointer-events: none !important;
    }

    /* Smoke puff ring when object is eliminated */
    @keyframes poofSmoke {
      0% {
        transform: translate(-50%, -50%) scale(0.2);
        opacity: 1;
      }
      100% {
        transform: translate(-50%, -50%) scale(2.3);
        opacity: 0;
      }
    }
    .poof-particle {
      position: absolute;
      pointer-events: none;
      animation: poofSmoke 0.6s ease-out forwards;
      z-index: 60;
    }

    /* Water splash animation */
    @keyframes waterSplash {
      0% { transform: scale(0.2) rotate(0deg); opacity: 1; }
      50% { transform: scale(1.15) rotate(15deg); opacity: 0.9; }
      100% { transform: scale(1.65) rotate(35deg); opacity: 0; }
    }
    .splash-effect {
      position: absolute;
      pointer-events: none;
      animation: waterSplash 0.5s ease-out forwards;
      z-index: 55;
    }

    /* Water stream tracer from gun to target */
    @keyframes waterTracer {
      0% { stroke-dashoffset: 1000; opacity: 1; }
      100% { stroke-dashoffset: 0; opacity: 0; }
    }
    .water-stream-line {
      stroke-dasharray: 1000;
      animation: waterTracer 0.25s linear forwards;
    }

    /* Crying tears animation */
    @keyframes tearDrip {
      0% { transform: translateY(0); opacity: 1; }
      100% { transform: translateY(16px); opacity: 0; }
    }
    .tear-drop {
      animation: tearDrip 0.65s infinite ease-in;
    }

    /* Custom scrollbars */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); border-radius: 8px; }
    ::-webkit-scrollbar-thumb { background: #0ea5e9; border-radius: 8px; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center justify-between selection:bg-cyan-500 selection:text-white">

  <!-- TOP HEADER / NAV -->
  <header class="w-full max-w-7xl px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 z-30">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-cyan-500 via-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/30 text-white text-xl font-bold">
        <i class="fa-solid fa-crosshairs"></i>
      </div>
      <div>
        <h1 class="text-lg md:text-2xl font-fredoka font-bold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-yellow-300">
          Hide & Seek: English Word Hunter
        </h1>
        <p class="text-xs text-slate-400 flex items-center gap-1.5">
          <span>Bắn súng nước tìm bạn người que ẩn giấu</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block animate-ping"></span>
        </p>
      </div>
    </div>

    <!-- Quick Actions: Teacher Mode & Stats -->
    <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <!-- Teacher Mode Button -->
      <button id="open-teacher-btn" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white text-xs sm:text-sm font-bold flex items-center gap-2 shadow-lg shadow-purple-600/30 transition active:scale-95 border border-purple-400/40">
        <i class="fa-solid fa-chalkboard-user"></i>
        <span>⚙️ Chế độ Giáo Viên / Tùy Biến</span>
      </button>

      <!-- Stats pill -->
      <div class="flex items-center gap-2.5 bg-slate-900/90 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-slate-800 text-xs sm:text-sm shadow-inner">
        <div class="flex items-center gap-1 text-amber-400 font-bold" title="Điểm số">
          <i class="fa-solid fa-star"></i>
          <span id="score-display">0</span>
        </div>
        <div class="flex items-center gap-1 text-rose-400 font-bold" title="Combo Streak">
          <i class="fa-solid fa-fire"></i>
          <span id="streak-display">x0</span>
        </div>
        <!-- Captured friends counter in room -->
        <div class="flex items-center gap-1.5 text-yellow-300 font-bold bg-amber-500/10 px-2 py-0.5 rounded-lg border border-amber-500/30" title="Tổng số bạn vàng đã bị bắt trong phòng">
          <i class="fa-solid fa-child-reaching text-amber-400"></i>
          <span>Bị bắt:</span>
          <span id="captured-count-display">0</span>/<span id="total-target-display">0</span>
        </div>
        <button id="sound-btn" class="text-cyan-300 hover:text-cyan-200 p-1" title="Bật/Tắt âm">
          <i class="fa-solid fa-volume-high" id="sound-icon"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- CLUE BANNER / MISSION HUD -->
  <div class="w-full max-w-7xl px-3 sm:px-6 my-1 z-20">
    <div class="bg-gradient-to-r from-indigo-950/95 via-slate-900/95 to-blue-950/95 border-2 border-cyan-500/40 p-3 sm:p-4 rounded-2xl shadow-2xl backdrop-blur-md flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="flex items-start md:items-center gap-3 w-full">
        <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/50 flex-shrink-0 flex items-center justify-center text-amber-300 text-lg">
          <i class="fa-solid fa-lightbulb"></i>
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-2 flex-wrap mb-0.5">
            <span id="current-template-tag" class="px-2 py-0.5 rounded-md bg-cyan-500/20 text-cyan-300 text-[11px] font-bold uppercase tracking-wider border border-cyan-500/30">
              Giving Directions & Prepositions
            </span>
            <span class="text-xs text-slate-400 font-medium">Lắng nghe & quan sát manh mối nơi ẩn giấu:</span>
          </div>
          <p id="clue-english" class="text-base sm:text-lg font-bold text-yellow-200 tracking-wide font-fredoka leading-snug">
            "Loading mission clue..."
          </p>
          <p id="clue-vietnamese" class="text-xs sm:text-sm text-slate-300 font-medium mt-0.5">
            Đang tải dữ liệu nhiệm vụ...
          </p>
        </div>
      </div>
      
      <!-- Action buttons on Clue -->
      <div class="flex items-center gap-2 self-end md:self-center shrink-0">
        <button id="listen-clue-btn" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow shadow-blue-500/25 active:scale-95">
          <i class="fa-solid fa-volume-high"></i> Đọc manh mối (US)
        </button>
        <button id="skip-clue-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold flex items-center gap-1 transition">
          <i class="fa-solid fa-forward-step"></i> Đổi câu khác
        </button>
      </div>
    </div>
  </div>

  <!-- EXPANDED ROOM VIEWPORT & 2.5D CANVAS -->
  <main class="w-full max-w-7xl px-3 sm:px-6 flex-1 flex flex-col justify-center items-center my-1 relative">
    <div id="game-container" class="game-viewport relative w-full aspect-[16/9] max-h-[640px] min-h-[420px] bg-gradient-to-b from-[#061836] via-[#091b33] to-[#040e21] rounded-3xl border-4 border-slate-800 shadow-[0_25px_60px_rgba(0,0,0,0.85)] overflow-hidden">
      
      <!-- Blue Vertical Striped Wall (Exact Match with Reference Photo) -->
      <div class="absolute top-0 left-0 right-0 h-[65%] flex pointer-events-none opacity-35">
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div><div class="flex-1 bg-transparent"></div>
        <div class="flex-1 bg-[#0284c7]"></div>
      </div>

      <!-- Atmospheric Ambient Lighting & Room Vignette -->
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(2,6,23,0.8)_100%)]"></div>

      <!-- Polished Wooden Floor 2.5D Surface -->
      <div class="absolute bottom-0 left-0 right-0 h-[35%] bg-gradient-to-t from-[#1b0d05] via-[#2d180b] to-[#120a05] border-t-2 border-cyan-400/25 pointer-events-none">
        <div class="w-full h-full opacity-20 bg-[linear-gradient(90deg,transparent_49%,#000_50%,transparent_51%)] [background-size:52px_100%]"></div>
        <!-- Floor Reflection Highlights -->
        <div class="absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-cyan-400/10 to-transparent"></div>
      </div>

      <!-- DYNAMIC ROOM PROPS & HIDERS CONTAINER (Managed by JS) -->
      <div id="props-container" class="absolute inset-0 z-10">
        <!-- Expanded furniture: Bed, Sofa, Wardrobe, Paintings, Chair, Desk, etc. -->
      </div>

      <!-- WATER STREAM / LASER TRACER SVG LAYER -->
      <svg id="water-stream-svg" class="absolute inset-0 w-full h-full pointer-events-none z-35" style="z-index: 35;"></svg>

      <!-- WATER SPLASH PARTICLES LAYER -->
      <div id="splash-layer" class="absolute inset-0 pointer-events-none z-30"></div>

      <!-- FIRST PERSON TOY WATER GUN (White Seeker Character Arm & Toy Water Blaster) -->
      <div id="gun-hud" class="absolute -bottom-6 right-8 w-52 sm:w-64 pointer-events-none z-40 select-none origin-bottom-right transition-transform duration-75">
        <svg viewBox="0 0 220 160" fill="none" class="w-full drop-shadow-[0_20px_35px_rgba(0,0,0,0.95)]">
          <!-- White Player Arm holding the gun (Exact match with reference picture) -->
          <path d="M 175 110 Q 215 130 230 180 L 195 190 Q 165 140 150 120 Z" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="4"/>
          <!-- Gun Body Green -->
          <path d="M 60 76 L 160 76 Q 175 76 180 92 L 185 118 Q 185 132 165 132 L 150 132 L 140 102 L 60 102 Z" fill="#22c55e" stroke="#15803d" stroke-width="4" stroke-linejoin="round"/>
          <!-- Orange Cylindrical Water Pressure Tank (Reference picture) -->
          <rect x="80" y="48" width="76" height="28" rx="14" fill="#f97316" stroke="#c2410c" stroke-width="3.5" />
          <circle cx="146" cy="62" r="7" fill="#fb923c" />
          <line x1="94" y1="52" x2="94" y2="72" stroke="#ea580c" stroke-width="3.5" />
          <line x1="112" y1="52" x2="112" y2="72" stroke="#ea580c" stroke-width="3.5" />
          <!-- Neon Blue Side Accent & Yellow Trigger Guard -->
          <rect x="90" y="84" width="36" height="9" rx="4.5" fill="#06b6d4" />
          <path d="M 135 98 Q 124 114 140 118" stroke="#facc15" stroke-width="5" stroke-linecap="round"/>
          <!-- Purple & Blue Nozzle Water Emitter -->
          <path d="M 44 82 L 60 78 L 60 98 L 44 94 Z" fill="#a855f7" stroke="#7e22ce" stroke-width="3.5" />
          <rect x="32" y="85" width="12" height="6" rx="3" fill="#38bdf8" />
          <!-- White Hand Clamping Grip -->
          <ellipse cx="160" cy="115" rx="14" ry="10" fill="#f8fafc" stroke="#94a3b8" stroke-width="3"/>
          <ellipse cx="145" cy="112" rx="7" ry="10" fill="#f8fafc" stroke="#94a3b8" stroke-width="3"/>
        </svg>
      </div>

      <!-- Water Ammo Gauge -->
      <div class="absolute bottom-4 left-4 z-20 bg-slate-900/90 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-slate-700/80 flex items-center gap-2 shadow-lg">
        <i class="fa-solid fa-droplet text-cyan-400 animate-pulse text-sm"></i>
        <div class="w-24 sm:w-32 bg-slate-800 h-2.5 rounded-full overflow-hidden border border-slate-700">
          <div id="water-bar" class="bg-gradient-to-r from-cyan-400 to-blue-500 h-full w-full transition-all duration-300"></div>
        </div>
        <span class="text-xs font-bold text-cyan-300" id="water-text">100%</span>
      </div>

      <!-- Quick Guidance Overlay -->
      <div class="absolute top-3 left-4 z-20 bg-slate-950/75 backdrop-blur-sm px-3 py-1.5 rounded-xl border border-slate-800 text-xs text-slate-300 pointer-events-none flex items-center gap-2 shadow-lg">
        <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i>
        <span>Bắn nước trúng: <b>Đồ vật biến mất</b>, <b>Bạn vàng đứng lại khóc</b> để đếm tổng số!</span>
      </div>

      <!-- Toast Feedback inside canvas -->
      <div id="feedback-toast" class="absolute top-6 left-1/2 -translate-x-1/2 -translate-y-12 opacity-0 transition-all duration-300 z-50 pointer-events-none px-4 py-2 rounded-2xl text-xs sm:text-sm font-bold shadow-2xl flex items-center gap-2"></div>
    </div>
  </main>

  <!-- VOCABULARY POPUP MODAL (When hider is uncovered) -->
  <div id="vocab-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-gradient-to-b from-slate-900 via-indigo-950 to-slate-900 border-2 border-cyan-400 rounded-3xl p-6 max-w-md w-full shadow-[0_0_50px_rgba(6,182,212,0.35)] relative text-center transform transition-all scale-95 duration-200" id="vocab-modal-content">
      
      <!-- Close Button -->
      <button id="modal-close-btn" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-slate-800/80 p-2 rounded-full w-9 h-9 flex items-center justify-center transition">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <!-- Found Badge & Crying Yellow Dummy Avatar from photo -->
      <div class="relative mb-2 flex justify-center">
        <div class="w-24 h-24 rounded-full bg-amber-400/20 border-2 border-amber-400 flex items-center justify-center shadow-lg shadow-amber-400/20">
          <svg viewBox="0 0 90 90" class="w-16 h-16 filter drop-shadow">
            <!-- Tears -->
            <path d="M 22 28 Q 16 20 20 34 Z" fill="#38bdf8" />
            <path d="M 68 28 Q 74 20 70 34 Z" fill="#38bdf8" />
            <path d="M 18 20 Q 12 14 15 24 Z" fill="#7dd3fc" />
            <path d="M 72 20 Q 78 14 75 24 Z" fill="#7dd3fc" />
            <!-- Head -->
            <circle cx="45" cy="40" r="22" fill="#f59e0b" stroke="#d97706" stroke-width="3"/>
            <!-- Sad Crying Eyes -->
            <path d="M 36 36 Q 40 32 44 36" stroke="#78350f" stroke-width="3" fill="none" stroke-linecap="round"/>
            <path d="M 46 36 Q 50 32 54 36" stroke="#78350f" stroke-width="3" fill="none" stroke-linecap="round"/>
            <ellipse cx="45" cy="48" rx="6" ry="5" fill="#78350f" />
          </svg>
        </div>
        <span class="absolute -bottom-2 bg-emerald-500 text-white text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider shadow">
          🎉 BẮT ĐƯỢC RỒI! (FOUND)
        </span>
      </div>

      <!-- Target Word Title -->
      <div class="mt-4 flex items-center justify-center gap-3">
        <h2 id="modal-word" class="text-3xl font-fredoka font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-yellow-300">
          Bed
        </h2>
        <button id="modal-speak-btn" class="w-10 h-10 rounded-full bg-cyan-500 hover:bg-cyan-400 text-white flex items-center justify-center shadow-md shadow-cyan-500/40 transition active:scale-90" title="Phát âm từ vựng">
          <i class="fa-solid fa-volume-high text-lg"></i>
        </button>
      </div>

      <!-- IPA Phonetics -->
      <p id="modal-ipa" class="text-sm font-mono text-cyan-400 mt-0.5">/bed/</p>

      <!-- Meaning Box -->
      <div class="my-3 py-2 px-4 bg-slate-800/80 rounded-xl border border-slate-700">
        <p class="text-xs text-slate-400 uppercase font-semibold">Nghĩa tiếng Việt:</p>
        <p id="modal-meaning" class="text-lg font-bold text-yellow-300 mt-0.5">Chiếc giường</p>
      </div>

      <!-- Grammar / Sentence Context Box -->
      <div class="text-left bg-indigo-950/50 p-3 rounded-xl border border-indigo-800/40 text-xs sm:text-sm space-y-1.5 mb-4">
        <div class="text-cyan-300 flex items-center gap-1.5 font-bold">
          <i class="fa-solid fa-bullseye"></i>
          <span id="modal-prep-tag">Vị trí: UNDER (Ở dưới gầm)</span>
        </div>
        <p id="modal-sentence" class="text-slate-200 italic font-medium">
          "The yellow figure was hiding under the comfortable bed."
        </p>
      </div>

      <!-- Action buttons -->
      <div class="flex gap-2">
        <button id="modal-repeat-btn" class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl font-bold text-xs sm:text-sm transition">
          <i class="fa-solid fa-microphone-lines mr-1 text-cyan-400"></i> Luyện nghe câu
        </button>
        <button id="modal-next-btn" class="flex-1 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold rounded-xl text-xs sm:text-sm shadow-lg shadow-cyan-500/30 transition active:scale-95">
          Tiếp tục săn <i class="fa-solid fa-arrow-right ml-1"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- TEACHER / CREATOR STUDIO MODAL -->
  <div id="teacher-modal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center p-3 sm:p-5 hidden">
    <div class="bg-slate-900 border-2 border-purple-500/50 rounded-3xl p-5 sm:p-6 max-w-3xl w-full max-h-[92vh] flex flex-col shadow-2xl relative">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30 flex items-center justify-center text-lg">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <div>
            <h3 class="text-lg sm:text-xl font-fredoka font-bold text-white">Chế độ Giáo Viên / Tùy Biến Bài Học</h3>
            <p class="text-xs text-slate-400">Chọn đồ vật phong phú (giường, bàn học, ghế bành, tranh tường, kệ sách...), tạo câu đố hoặc xuất JSON</p>
          </div>
        </div>
        <button id="close-teacher-btn" class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center transition">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Main Body: Tabs & Content -->
      <div class="flex-1 overflow-y-auto py-3 space-y-4">

        <!-- Template Selector Quick Presets -->
        <div class="bg-slate-800/70 p-3.5 rounded-2xl border border-slate-700/80">
          <label class="text-xs font-bold text-purple-300 uppercase block mb-1.5">
            <i class="fa-solid fa-layer-group mr-1"></i> 1. Chọn Template mẫu có sẵn:
          </label>
