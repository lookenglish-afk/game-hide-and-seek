      bindEvents() {
        // First-Person Water Gun Aiming with mouse
        this.gameContainer.addEventListener('mousemove', (e) => {
          const rect = this.gameContainer.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const deltaX = (x / rect.width - 0.5) * 45;
          const deltaY = (y / rect.height - 0.5) * -15;
          this.gunHud.style.transform = `translateX(${deltaX}px) rotate(${deltaX * 0.18}deg) translateY(${deltaY}px)`;
        });

        // Click on background shoots water
        this.gameContainer.addEventListener('click', (e) => {
          this.shootWaterStream(e);
          this.createWaterSplash(e);
          sound.playShoot();
          this.consumeWater();
        });

        // Sound Toggle
        this.soundBtn.addEventListener('click', () => {
          sound.enabled = !sound.enabled;
          this.soundIcon.className = sound.enabled ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark text-slate-500';
        });

        // Clue speech
        this.listenClueBtn.addEventListener('click', () => {
          if (this.activeTargetItem) speakEnglish(this.activeTargetItem.clueEn);
        });

        // Skip Clue
        this.skipClueBtn.addEventListener('click', () => {
          this.pickNewTarget();
          this.showToast('Đã đổi sang câu manh mối khác!', 'info');
        });

        // Vocab modal actions
        this.modalSpeakBtn.addEventListener('click', () => {
          if (this.activeTargetItem) speakEnglish(this.activeTargetItem.word);
        });

        this.modalRepeatBtn.addEventListener('click', () => {
          if (this.activeTargetItem) {
            speakEnglish(`${this.activeTargetItem.word}. ${this.activeTargetItem.sentence || this.activeTargetItem.clueEn}`);
          }
        });

        // KEY REQUIREMENT 1: OBJECT IS ELIMINATED, BUT YELLOW FIGURE STAYS STANDING!
        const closeVocab = () => {
          this.vocabModal.classList.add('hidden');
          
          if (this.pendingEliminatePropId) {
            this.eliminateObjectOnly(this.pendingEliminatePropId);
            this.pendingEliminatePropId = null;
          }

          if (this.capturedMap.size >= this.currentItems.length) {
            setTimeout(() => this.showVictory(), 800);
          } else {
            this.pickNewTarget();
          }
        };
        this.modalCloseBtn.addEventListener('click', closeVocab);
        this.modalNextBtn.addEventListener('click', closeVocab);

        // Teacher modal
        this.openTeacherBtn.addEventListener('click', () => this.openTeacherPanel());
        this.closeTeacherBtn.addEventListener('click', () => this.teacherModal.classList.add('hidden'));
        this.applyAndStartBtn.addEventListener('click', () => {
          this.teacherModal.classList.add('hidden');
          this.initGameRound();
        });

        // Summary restart
        this.restartGameBtn.addEventListener('click', () => {
          this.summaryModal.classList.add('hidden');
          this.score = 0;
          this.streak = 0;
          this.initGameRound();
        });

        this.openTeacherFromEnd.addEventListener('click', () => {
          this.summaryModal.classList.add('hidden');
          this.openTeacherPanel();
        });

        this.bindTeacherStudio();
      }

      consumeWater() {
        this.waterAmmo -= 5;
        if (this.waterAmmo <= 10) {
          this.waterAmmo = 100;
          this.showToast('💦 Đã nạp đầy bình nước đồ chơi!', 'info');
        }
        this.waterBar.style.width = `${this.waterAmmo}%`;
        this.waterText.innerText = `${this.waterAmmo}%`;
      }

      shootWaterStream(e) {
        const rect = this.gameContainer.getBoundingClientRect();
        const targetX = e.clientX - rect.left;
        const targetY = e.clientY - rect.top;

        const nozzleX = rect.width * 0.82;
        const nozzleY = rect.height * 0.88;

        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        const controlX = (nozzleX + targetX) / 2 + (Math.random() * 40 - 20);
        const controlY = Math.min(nozzleY, targetY) - 35;
        
        path.setAttribute("d", `M ${nozzleX} ${nozzleY} Q ${controlX} ${controlY} ${targetX} ${targetY}`);
        path.setAttribute("stroke", "#38bdf8");
        path.setAttribute("stroke-width", "5.5");
        path.setAttribute("fill", "none");
        path.setAttribute("stroke-linecap", "round");
        path.setAttribute("class", "water-stream-line");
        path.setAttribute("filter", "drop-shadow(0 0 8px #0284c7)");

        this.streamSvg.appendChild(path);
        setTimeout(() => path.remove(), 260);
      }

      initGameRound() {
        this.capturedMap.clear();
        this.eliminatedPropsSet.clear();
        this.pendingEliminatePropId = null;
        this.currentTemplateTag.innerText = this.templateTitle;
        this.updateStats();

        // Render clean expanded room props (All hiders completely hidden inside/behind)
        this.renderExpandedRoom();

        // Pick initial target
        this.pickNewTarget();
      }

      renderExpandedRoom() {
        this.propsContainer.innerHTML = '';
        const allKeys = Object.keys(ROOM_PROPS);

        allKeys.forEach((key) => {
          const propDef = ROOM_PROPS[key];
          const wrapper = document.createElement('div');
          wrapper.id = `prop-box-${propDef.id}`;
          wrapper.className = 'absolute cursor-pointer group transition-all duration-300';
          wrapper.style.left = `${propDef.position.left}%`;
          wrapper.style.top = `${propDef.position.top}%`;
          wrapper.style.width = `${propDef.position.width}%`;
          wrapper.style.height = `${propDef.position.height}%`;

          // Structure:
          // 1. #hider-slot: The yellow stickman standing slot (revealed & stays standing permanently!)
          // 2. #prop-visual: The furniture SVG (gets eliminated/poofs away when shot!)
          wrapper.innerHTML = `
            <div id="prop-inner-${propDef.id}" class="relative w-full h-full flex items-center justify-center">
              <!-- Hider Slot: Stays in room permanently once discovered! -->
              <div id="hider-slot-${propDef.id}" class="absolute -top-10 sm:-top-14 z-20 hidden"></div>
              
              <!-- Front Furniture Prop SVG that conceals the hider -->
              <div id="prop-visual-${propDef.id}" class="relative z-10 w-full h-full transition-transform duration-200 group-hover:scale-[1.03]">
                ${propDef.render()}
              </div>

              <!-- Faint floor outline marker once object is gone -->
              <div id="eliminated-tag-${propDef.id}" class="absolute -bottom-2 inset-x-0 text-center pointer-events-none opacity-0 transition-opacity duration-500">
                <span class="text-[9px] font-fredoka font-bold text-cyan-400/50 bg-slate-900/60 px-2 py-0.5 rounded-full border border-dashed border-cyan-400/30">
                  ✓ CLEARED
                </span>
              </div>
            </div>
          `;

          // Click on prop
          wrapper.addEventListener('click', (e) => {
            e.stopPropagation();
            if (this.eliminatedPropsSet.has(propDef.id)) {
              this.showToast('Bạn vàng ở đây đã bị bắt rồi! Hãy tìm kiếm những nơi khác.', 'info');
              return;
            }
            this.shootWaterStream(e);
            this.createWaterSplash(e);
            sound.playShoot();
            this.handlePropShot(propDef.id);
          });

          this.propsContainer.appendChild(wrapper);
        });
      }

      pickNewTarget() {
        const remaining = this.currentItems.filter(item => !this.eliminatedPropsSet.has(item.propId));
        if (remaining.length === 0) {
          this.showVictory();
          return;
        }

        this.activeTargetItem = remaining[Math.floor(Math.random() * remaining.length)];
        this.clueEnglish.innerText = `"${this.activeTargetItem.clueEn}"`;
        this.clueVietnamese.innerText = this.activeTargetItem.clueVi || "Quan sát và đoán xem đây là đồ vật nào trong phòng!";
        speakEnglish(this.activeTargetItem.clueEn);
      }

      handlePropShot(propId) {
        if (!this.activeTargetItem) return;

        const propVisual = document.getElementById(`prop-visual-${propId}`);
        const hiderSlot = document.getElementById(`hider-slot-${propId}`);

        if (propVisual) {
          propVisual.classList.add('shake-prop');
          setTimeout(() => propVisual.classList.remove('shake-prop'), 450);
        }

        // Correct target found!
        if (propId === this.activeTargetItem.id || propId === this.activeTargetItem.propId) {
          sound.playCatch();
          this.score += 100 + (this.streak * 25);
          this.streak++;
          this.capturedMap.set(propId, this.activeTargetItem);
          this.pendingEliminatePropId = propId;
          this.updateStats();

          try {
            confetti({
              particleCount: 50,
              spread: 60,
              origin: { y: 0.6 }
            });
          } catch(e) {}

          // Reveal yellow figure with surrendering crying pose & index count
          if (hiderSlot) {
            hiderSlot.innerHTML = getCapturedYellowFigureSvg(this.capturedMap.size);
            hiderSlot.classList.remove('hidden');
          }

          this.showToast(`🎯 CHÍNH XÁC! Bạn người que vàng đã bị bắt! (+${100 + (this.streak * 25)}đ)`, 'success');

          setTimeout(() => {
            this.openVocabModal(this.activeTargetItem);
          }, 600);

        } else {
          // Missed / wrong object
          sound.playMiss();
          this.streak = 0;
          this.updateStats();
          this.showToast(`❌ Không có ai trốn ở đây cả! Đọc kỹ gợi ý nhé.`, 'warning');
        }
      }

      /* =====================================================================
         KEY UPDATE: OBJECT DISAPPEARS, BUT YELLOW STICKMAN STAYS IN ROOM!
         ===================================================================== */
      eliminateObjectOnly(propId) {
        this.eliminatedPropsSet.add(propId);
        sound.playEliminate();

        const box = document.getElementById(`prop-box-${propId}`);
        const propVisual = document.getElementById(`prop-visual-${propId}`);
        const eliminatedTag = document.getElementById(`eliminated-tag-${propId}`);
        const hiderSlot = document.getElementById(`hider-slot-${propId}`);

        if (box && propVisual) {
          // Smoke puff over the disappearing object
          this.createPoofSmoke(box);

          // Animate ONLY the furniture object disappearing
          propVisual.classList.add('animate-eliminate-object');

          setTimeout(() => {
            propVisual.style.display = 'none';
            // Disable shooting this area again
            box.style.pointerEvents = 'none';
            box.style.cursor = 'default';

            if (eliminatedTag) {
              eliminatedTag.classList.remove('opacity-0');
              eliminatedTag.classList.add('opacity-100');
            }

            // CRITICAL: The yellow stickman remains standing firmly in place!
            if (hiderSlot) {
              hiderSlot.style.zIndex = '25';
              hiderSlot.classList.remove('hidden');
            }
          }, 620);
        }

        this.showToast(`✨ Đồ vật biến mất, bạn vàng đứng lại phòng để đếm tổng số!`, 'info');
      }

      createPoofSmoke(parentElem) {
        const rect = parentElem.getBoundingClientRect();
        const containerRect = this.gameContainer.getBoundingClientRect();

        const centerX = rect.left - containerRect.left + rect.width / 2;
        const centerY = rect.top - containerRect.top + rect.height / 2;

        const poof = document.createElement('div');
        poof.className = 'poof-particle';
        poof.style.left = `${centerX}px`;
        poof.style.top = `${centerY}px`;
        poof.style.width = '140px';
        poof.style.height = '140px';

        poof.innerHTML = `
          <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-[0_0_12px_#38bdf8]">
            <circle cx="50" cy="50" r="30" fill="#38bdf8" opacity="0.45"/>
            <circle cx="35" cy="35" r="18" fill="#e0f2fe" opacity="0.85"/>
            <circle cx="65" cy="40" r="16" fill="#7dd3fc" opacity="0.75"/>
            <circle cx="45" cy="65" r="20" fill="#bae6fd" opacity="0.65"/>
            <polygon points="50,15 54,26 65,30 54,34 50,45 46,34 35,30 46,26" fill="#facc15"/>
            <polygon points="75,65 77,72 84,75 77,78 75,85 73,78 66,75 73,72" fill="#ffffff"/>
            <polygon points="25,65 27,70 32,72 27,74 25,79 23,74 18,72 23,70" fill="#facc15"/>
          </svg>
        `;

        this.splashLayer.appendChild(poof);
        setTimeout(() => poof.remove(), 600);
      }

      openVocabModal(item) {
        this.modalWord.innerText = item.word;
        this.modalIpa.innerText = item.ipa || "";
        this.modalMeaning.innerText = item.meaning || "Từ vựng tiếng Anh";
        this.modalPrepTag.innerHTML = `<i class="fa-solid fa-bullseye"></i> ${item.prep || "Vị trí trong phòng"}`;
        this.modalSentence.innerText = `"${item.sentence || item.clueEn}"`;

        this.vocabModal.classList.remove('hidden');
        speakEnglish(item.word);
      }

      createWaterSplash(e) {
        const rect = this.gameContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const splash = document.createElement('div');
        splash.className = 'splash-effect';
        splash.style.left = `${x - 45}px`;
        splash.style.top = `${y - 45}px`;
        splash.style.width = '90px';
        splash.style.height = '90px';

        splash.innerHTML = `
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <circle cx="50" cy="50" r="22" fill="#38bdf8" opacity="0.6"/>
            <circle cx="50" cy="50" r="9" fill="#ffffff" opacity="0.9"/>
            <circle cx="18" cy="30" r="5" fill="#0284c7" />
            <circle cx="82" cy="25" r="4.5" fill="#38bdf8" />
            <circle cx="80" cy="72" r="5" fill="#0ea5e9" />
            <circle cx="22" cy="75" r="4.5" fill="#38bdf8" />
            <circle cx="50" cy="12" r="6" fill="#7dd3fc" />
          </svg>
        `;
        this.splashLayer.appendChild(splash);
        setTimeout(() => splash.remove(), 550);
      }

      showToast(text, type = 'info') {
        const colors = {
          success: 'bg-emerald-600 text-white border-emerald-400',
          warning: 'bg-amber-600 text-white border-amber-400',
          info: 'bg-cyan-700 text-white border-cyan-400'
        };

        this.toast.className = `absolute top-6 left-1/2 -translate-x-1/2 translate-y-0 opacity-100 transition-all duration-300 z-50 pointer-events-none px-4 py-2 rounded-2xl text-xs sm:text-sm font-bold shadow-2xl flex items-center gap-2 border ${colors[type]}`;
        this.toast.innerHTML = text;

        setTimeout(() => {
          this.toast.classList.remove('translate-y-0', 'opacity-100');
          this.toast.classList.add('-translate-y-12', 'opacity-0');
        }, 1700);
      }

      updateStats() {
        this.scoreDisplay.innerText = this.score;
        this.streakDisplay.innerText = `x${this.streak}`;
        this.capturedCountDisplay.innerText = this.capturedMap.size;
        this.totalTargetDisplay.innerText = this.currentItems.length;
      }

      showVictory() {
        sound.playVictory();
        try {
          confetti({
            particleCount: 130,
            spread: 90,
            origin: { y: 0.5 }
          });
        } catch(e) {}

        this.finalScore.innerText = this.score;
        this.finalStreak.innerText = `x${this.streak}`;
        this.finalCaughtCount.innerText = `${this.capturedMap.size}/${this.currentItems.length} bạn`;

        // Render Review Cards
        this.reviewList.innerHTML = '';
        this.currentItems.forEach((item) => {
          const card = document.createElement('div');
          card.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-800 border border-slate-700 text-xs';
          card.innerHTML = `
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</span>
              <div>
                <span class="font-bold text-white text-sm">${item.word}</span>
                <span class="text-cyan-400 font-mono text-[11px] ml-1">${item.ipa || ''}</span>
                <div class="text-[11px] text-slate-300">${item.meaning || ''}</div>
              </div>
            </div>
            <button class="p-2 hover:bg-slate-700 text-cyan-300 rounded-lg text-sm review-snd-btn" title="Nghe lại">
              <i class="fa-solid fa-volume-high"></i>
            </button>
          `;
          card.querySelector('.review-snd-btn').addEventListener('click', () => {
            speakEnglish(item.word);
          });
          this.reviewList.appendChild(card);
        });

        this.summaryModal.classList.remove('hidden');
      }

      /* =====================================================================
         7. TEACHER STUDIO LOGIC & JSON IMPORT / EXPORT
         ===================================================================== */
      bindTeacherStudio() {
        const propSelect = document.getElementById('editor-prop-id');
        const wordInput = document.getElementById('editor-word');
        const ipaInput = document.getElementById('editor-ipa');
        const meaningInput = document.getElementById('editor-meaning');
        const clueEnInput = document.getElementById('editor-clue-en');
        const clueViInput = document.getElementById('editor-clue-vi');
        const sentenceInput = document.getElementById('editor-sentence');
        const saveBtn = document.getElementById('editor-save-item-btn');
        const resetFormBtn = document.getElementById('editor-reset-form-btn');

        // Presets switch
        document.getElementById('tpl-directions-btn').addEventListener('click', () => {
          this.currentItems = JSON.parse(JSON.stringify(PRESET_TEMPLATES.directions.items));
          this.templateTitle = PRESET_TEMPLATES.directions.title;
          this.refreshTeacherItemsList();
          this.showToast('Đã chuyển sang Template: Giving Directions!', 'info');
        });

        document.getElementById('tpl-riddles-btn').addEventListener('click', () => {
          this.currentItems = JSON.parse(JSON.stringify(PRESET_TEMPLATES.riddles.items));
          this.templateTitle = PRESET_TEMPLATES.riddles.title;
          this.refreshTeacherItemsList();
          this.showToast('Đã chuyển sang Template: House & Furniture Riddles!', 'info');
        });

        document.getElementById('tpl-phonics-btn').addEventListener('click', () => {
          this.currentItems = JSON.parse(JSON.stringify(PRESET_TEMPLATES.phonics.items));
          this.templateTitle = PRESET_TEMPLATES.phonics.title;
          this.refreshTeacherItemsList();
          this.showToast('Đã chuyển sang Template: Daily Life & Verbs!', 'info');
        });

        // Reset form
        resetFormBtn.addEventListener('click', () => {
          wordInput.value = '';
          ipaInput.value = '';
          meaningInput.value = '';
          clueEnInput.value = '';
          clueViInput.value = '';
          sentenceInput.value = '';
        });

        // Save / Update question
        saveBtn.addEventListener('click', () => {
          const propId = propSelect.value;
          const word = wordInput.value.trim();
          const clueEn = clueEnInput.value.trim();

          if (!word || !clueEn) {
            this.showToast('Vui lòng nhập Từ vựng & Câu manh mối tiếng Anh!', 'warning');
            return;
          }

          const existingIndex = this.currentItems.findIndex(it => it.propId === propId);
          const newItem = {
            propId: propId,
            word: word,
            ipa: ipaInput.value.trim(),
            meaning: meaningInput.value.trim(),
            clueEn: clueEn,
            clueVi: clueViInput.value.trim(),
            sentence: sentenceInput.value.trim(),
            prep: `AT ${propId.toUpperCase()}`
          };

          if (existingIndex >= 0) {
            this.currentItems[existingIndex] = newItem;
          } else {
            this.currentItems.push(newItem);
          }

          this.refreshTeacherItemsList();
          this.showToast('Đã lưu câu đố thành công!', 'success');
        });

        // JSON Export / Import
        const jsonArea = document.getElementById('json-textarea');
        document.getElementById('export-json-btn').addEventListener('click', () => {
          const dataToExport = {
            title: this.templateTitle,
            items: this.currentItems
          };
          jsonArea.value = JSON.stringify(dataToExport, null, 2);
          this.showToast('Đã xuất dữ liệu ra định dạng JSON!', 'info');
        });

        document.getElementById('import-json-btn').addEventListener('click', () => {
          try {
            const parsed = JSON.parse(jsonArea.value.trim());
            if (parsed && Array.isArray(parsed.items)) {
              this.currentItems = parsed.items;
              if (parsed.title) this.templateTitle = parsed.title;
              this.refreshTeacherItemsList();
              this.showToast('Đã nhập thành công bộ câu hỏi mới!', 'success');
            } else {
              this.showToast('Cấu trúc JSON không hợp lệ!', 'warning');
            }
          } catch(e) {
            this.showToast('Lỗi đọc JSON: ' + e.message, 'warning');
          }
        });
      }

      openTeacherPanel() {
        this.refreshTeacherItemsList();
        this.teacherModal.classList.remove('hidden');
      }

      refreshTeacherItemsList() {
        const listContainer = document.getElementById('editor-items-list');
        const countSpan = document.getElementById('editor-items-count');
        listContainer.innerHTML = '';
        countSpan.innerText = `${this.currentItems.length} câu đố`;

        this.currentItems.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between p-2 rounded-xl bg-slate-900 border border-slate-700/80 text-xs';
          row.innerHTML = `
            <div class="flex-1 pr-2">
              <span class="font-bold text-cyan-300">[${item.propId}] ${item.word}</span>
              <span class="text-slate-400 ml-1">(${item.meaning || ''})</span>
              <div class="text-[11px] text-slate-300 italic truncate max-w-sm">"${item.clueEn}"</div>
            </div>
            <div class="flex items-center gap-1.5">
              <button class="edit-btn p-1.5 text-cyan-400 hover:bg-slate-800 rounded-lg" title="Sửa">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button class="del-btn p-1.5 text-rose-400 hover:bg-slate-800 rounded-lg" title="Xóa">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </div>
          `;

          row.querySelector('.edit-btn').addEventListener('click', () => {
            document.getElementById('editor-prop-id').value = item.propId;
            document.getElementById('editor-word').value = item.word;
            document.getElementById('editor-ipa').value = item.ipa || '';
            document.getElementById('editor-meaning').value = item.meaning || '';
            document.getElementById('editor-clue-en').value = item.clueEn || '';
            document.getElementById('editor-clue-vi').value = item.clueVi || '';
            document.getElementById('editor-sentence').value = item.sentence || '';
          });

          row.querySelector('.del-btn').addEventListener('click', () => {
            if (this.currentItems.length <= 1) {
              this.showToast('Phòng chơi phải có ít nhất 1 câu đố!', 'warning');
              return;
            }
            this.currentItems.splice(index, 1);
            this.refreshTeacherItemsList();
          });

          listContainer.appendChild(row);
        });

        document.getElementById('json-textarea').value = JSON.stringify({
          title: this.templateTitle,
          items: this.currentItems
        }, null, 2);
      }
    }

    // Launch game when window is ready
    window.addEventListener('load', () => {
      new HideAndSeekApp();
    });
  </script>
</body>
