    /* =====================================================================
       1. WEB AUDIO SYNTHESIZER
       ===================================================================== */
    class AudioSynthesizer {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }
      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }
      playShoot() {
        if (!this.enabled) return;
        this.init();
        const ctx = this.ctx;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(820, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(160, ctx.currentTime + 0.12);

        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.12);
      }
      playMiss() {
        if (!this.enabled) return;
        this.init();
        const ctx = this.ctx;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(180, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.18);

        gain.gain.setValueAtTime(0.18, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.18);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.18);
      }
      // Yellow stickman crying squeak / whimper sound when caught
      playCatch() {
        if (!this.enabled) return;
        this.init();
        const ctx = this.ctx;
        
        // Joyful ding chime
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.06);

          gain.gain.setValueAtTime(0.18, ctx.currentTime + idx * 0.06);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.06 + 0.22);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + idx * 0.06);
          osc.stop(ctx.currentTime + idx * 0.06 + 0.22);
        });

        // Funny crying squeak of the yellow figure
        setTimeout(() => {
          if (!this.enabled || !this.ctx) return;
          const squeak = ctx.createOscillator();
          const sqGain = ctx.createGain();
          squeak.type = 'sine';
          squeak.frequency.setValueAtTime(600, ctx.currentTime);
          squeak.frequency.linearRampToValueAtTime(320, ctx.currentTime + 0.2);
          squeak.frequency.linearRampToValueAtTime(550, ctx.currentTime + 0.35);

          sqGain.gain.setValueAtTime(0.15, ctx.currentTime);
          sqGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);

          squeak.connect(sqGain);
          sqGain.connect(ctx.destination);
          squeak.start();
          squeak.stop(ctx.currentTime + 0.35);
        }, 120);
      }
      // Object Elimination "Poof / Whoosh" Sound
      playEliminate() {
        if (!this.enabled) return;
        this.init();
        const ctx = this.ctx;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(320, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.25);
        osc.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.45);

        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.45);
      }
      // Victory Fanfare
      playVictory() {
        if (!this.enabled) return;
        this.init();
        const ctx = this.ctx;
        const chord = [440, 554.37, 659.25, 880];
        chord.forEach((freq) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, ctx.currentTime);
          gain.gain.setValueAtTime(0.2, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.9);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.9);
        });
      }
    }
